# Optional. Leave blank locally. Set in Vercel for production.

# Google Analytics 4 measurement ID (G-XXXX). Omit to skip gtag.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag token. Defaults to the live Search Console
# token in src/lib/site.ts. Override here only if Google issues a new one.
NEXT_PUBLIC_GSC_VERIFICATION=

# Public challenge peek (defaults to the production Cloud Function).
CHALLENGE_PEEK_URL=
